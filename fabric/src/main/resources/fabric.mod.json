{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": ["brandon3055", "CreeperHost"],
  "contact": {
    "sources": "https://github.com/CreeperHost/BackupManager",
    "issues": "https://github.com/CreeperHost/BackupManager/issues"
  },
  "license": "${license}",
  "environment": "client",
  "entrypoints": {
    "client": ["net.creeperhost.backupmanager.fabric.BackupManagerFabric"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "polylib": ">=${polylib_min_version}"
  },
  "mixins": ["backupmanager-common.mixins.json"]
}
